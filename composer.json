{
    "name": "mehtayukta/notifycord",
    "description": "A Laravel package for sending Discord notifications with rich formatting",
    "keywords": ["laravel", "discord", "notification", "webhook", "bot"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yukta Mehta",
            "email": "example@example.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.0",
        "illuminate/notifications": "^9.0|^10.0",
        "illuminate/support": "^9.0|^10.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^7.0|^8.0",
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "MehtaYukta\\NotifyCord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MehtaYukta\\NotifyCord\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MehtaYukta\\NotifyCord\\NotifyCordServiceProvider"
            ],
            "aliases": {
                "NotifyCord": "MehtaYukta\\NotifyCord\\Facades\\NotifyCord"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
